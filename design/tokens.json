{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Дизайн-токены ПСБ · Юридический ассистент · Hack&Change 2026. Источник правды для web/. Парный файл: tokens.css (CSS-переменные). Меняйте здесь — синхронизируйте в CSS.",
  "color": {
    "brand": {
      "blue950": "#070F33",
      "blue900": "#0B1B4D",
      "blue850": "#102156",
      "blue800": "#15296E",
      "blue700": "#1D3585",
      "blue600": "#2A4A9E",
      "blue500": "#3E63C4",
      "orange500": "#FF5C2B",
      "orange600": "#E8491A",
      "orangeGradient": "linear-gradient(135deg, #FF5C2B 0%, #FF8A50 100%)"
    },
    "surface": {
      "page": "#070F33",
      "panel": "#0B1B4D",
      "card": "#102156",
      "cardElevated": "#15296E",
      "hover": "#1D3585",
      "border": "rgba(185, 194, 222, 0.14)",
      "borderStrong": "rgba(185, 194, 222, 0.28)"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#B9C2DE",
      "muted": "#7A86A8",
      "onAccent": "#FFFFFF",
      "link": "#7FA0FF",
      "linkHover": "#A5BCFF"
    },
    "status": {
      "full": {
        "color": "#2FBF71",
        "bg": "rgba(47, 191, 113, 0.14)",
        "border": "rgba(47, 191, 113, 0.45)",
        "label": "Полный ответ",
        "icon": "shield-check"
      },
      "partial": {
        "color": "#F5B301",
        "bg": "rgba(245, 179, 1, 0.14)",
        "border": "rgba(245, 179, 1, 0.45)",
        "label": "Частичный ответ",
        "icon": "shield-half"
      },
      "refusal": {
        "color": "#E5484D",
        "bg": "rgba(229, 72, 77, 0.14)",
        "border": "rgba(229, 72, 77, 0.45)",
        "label": "Отказ",
        "icon": "shield-x"
      },
      "error": {
        "color": "#8A93AD",
        "bg": "rgba(138, 147, 173, 0.14)",
        "border": "rgba(138, 147, 173, 0.45)",
        "label": "Ошибка в вопросе",
        "icon": "question-circle"
      }
    },
    "state": {
      "skeleton": "rgba(185, 194, 222, 0.10)",
      "skeletonShimmer": "rgba(185, 194, 222, 0.22)",
      "dangerBg": "rgba(229, 72, 77, 0.10)",
      "successBg": "rgba(47, 191, 113, 0.10)",
      "highlightFragment": "rgba(255, 92, 43, 0.22)",
      "highlightFragmentBorder": "#FF5C2B"
    }
  },
  "typography": {
    "fontFamily": {
      "base": "'SB Sans Display', 'Segoe UI', 'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace"
    },
    "size": {
      "h1": "28px",
      "h2": "22px",
      "h3": "17px",
      "body": "14.5px",
      "bodySmall": "13px",
      "caption": "11.5px",
      "badge": "12px"
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "answer": 1.62
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "pill": "999px"
  },
  "shadow": {
    "card": "0 2px 12px rgba(3, 7, 22, 0.45)",
    "modal": "0 12px 48px rgba(3, 7, 22, 0.65)"
  },
  "motion": {
    "fast": "120ms ease-out",
    "normal": "200ms ease-out",
    "streamCursor": "blink 900ms step-end infinite"
  },
  "layout": {
    "chatMaxWidth": "720px",
    "sidebarWidth": "420px",
    "timelineHeight": "180px",
    "answerCardPadding": "16px 20px",
    "badgePadding": "3px 10px"
  }
}
