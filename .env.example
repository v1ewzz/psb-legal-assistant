# Скопировать в .env и заполнить. В репозиторий не класть (.gitignore).
# Все имена переменных — по таблице §2.4 спецификации.

# Адрес прокси API (первый непустой читается из LLM_BASE_URL / BASE_URL / OPENAI_BASE_URL)
LLM_BASE_URL=

# Ключ генерации (обязателен)
LLM_API_KEY=

# Ключ эмбеддера (fallback: LLM_API_KEY)
EMBEDDER_API_KEY=

# Ключ реранкера (fallback: LLM_API_KEY)
RERANKER_API_KEY=

# Модели (всегда из env; значения ниже — дефолты для локальной разработки)
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=cohere/rerank-5-fast

# Каталог входных файлов (questions.csv, kb.zip)
DATA_DIR=data

# Лимиты (клампятся кодом)
TOP_K=6
RERANKER_TOP_N=5
MAX_TOKENS=2000
MAX_WORKERS=4
TEMPERATURE=0.0

# Каналы и флаги (всё включено по умолчанию; 0/1)
HYBRID=1
RERANK=1
CLAIM_JUDGE=1
REWRITE_FOLLOWUPS=1
CITATION_LINT=1
# T5_GATE=0          # гейт ложных предпосылок в числах (по умолчанию выкл)
# AS_OF_DATE=2026-10-10   # «сегодня» для temporal-логики; пусто = дата выгрузки базы
